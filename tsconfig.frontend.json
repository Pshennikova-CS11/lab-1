{
  "compilerOptions": {
    "target": "ES2020",
    "module": "none",
    "rootDir": ".",
    "outDir": "dist-frontend",
    "strict": true,
    "lib": ["ES2020", "DOM"],
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "shared/**/*.ts",
    "frontend-ts/**/*.ts"
  ]
}